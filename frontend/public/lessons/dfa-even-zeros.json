{
 "id": "dfa-even-zeros",
 "title": "DFA: Even Number of 0s",
 "subject": "Theory of Computation",
 "layout": "classic",
 "languages": [
  "english"
 ],
 "teaching_profile": {
  "subject_type": "cs",
  "content_type": "concept",
  "level": "college"
 },
 "steps": [
  {
   "id": "s0",
   "title": "The language",
   "narration": {
    "en": "We want a machine that accepts strings of 0s and 1s with an even number of 0s."
   },
   "actions": [
    {
     "type": "heading",
     "text": "DFA: even number of 0s"
    },
    {
     "type": "write",
     "text": "Alphabet *{0, 1}*. Accept strings with an *even* number of 0s."
    },
    {
     "type": "bullet",
     "text": "Accept: 11, 1001, 00"
    },
    {
     "type": "bullet",
     "text": "Reject: !0!, !10!, !000!"
    }
   ]
  },
  {
   "id": "s1",
   "title": "States",
   "narration": {
    "en": "We only need to remember one bit: is the count of 0s so far even or odd? So two states, q0 for even and q1 for odd. q0 is the start and the accepting state."
   },
   "actions": [
    {
     "type": "automaton",
     "id": "A",
     "states": [
      "q0",
      "q1"
     ],
     "start": "q0",
     "accept": [
      "q0"
     ],
     "transitions": [
      {
       "from": "q0",
       "to": "q1",
       "label": "0"
      },
      {
       "from": "q1",
       "to": "q0",
       "label": "0"
      },
      {
       "from": "q0",
       "to": "q0",
       "label": "1"
      },
      {
       "from": "q1",
       "to": "q1",
       "label": "1"
      }
     ]
    },
    {
     "type": "side_note",
     "text": "*q0* = even so far, *q1* = odd so far."
    }
   ]
  },
  {
   "id": "s2",
   "title": "Transition table",
   "narration": {
    "en": "The same machine as a table: a 0 flips the state, a 1 keeps it."
   },
   "actions": [
    {
     "type": "table",
     "id": "T",
     "headers": [
      "State",
      "0",
      "1"
     ],
     "rows": [
      [
       "→ *q0",
       "q1",
       "q0"
      ],
      [
       "q1",
       "q0",
       "q1"
      ]
     ]
    },
    {
     "type": "highlight",
     "target": "T.h1",
     "style": "underline",
     "color": "blue"
    },
    {
     "type": "side_note",
     "text": "Reading a *0* flips the state. Reading a 1 keeps it."
    }
   ]
  },
  {
   "id": "s3",
   "title": "Trace 1001",
   "narration": {
    "en": "Trace 1001. Start at q0. 1 stays in q0, 0 goes to q1, the next 0 comes back to q0, and 1 stays. We end in q0, so the string is accepted."
   },
   "actions": [
    {
     "type": "array",
     "id": "w",
     "label": "w",
     "values": [
      "1",
      "0",
      "0",
      "1"
     ]
    },
    {
     "type": "write",
     "text": "q0 → q0 → q1 → q0 → q0"
    },
    {
     "type": "highlight",
     "target": "A.q0",
     "style": "circle",
     "color": "blue"
    },
    {
     "type": "write",
     "text": "Ends in q0: *accepted*"
    }
   ]
  },
  {
   "id": "s4",
   "title": "Takeaway",
   "narration": {
    "en": "A DFA state is a summary of everything that matters so far. Here, one bit of memory is enough."
   },
   "actions": [
    {
     "type": "side_note",
     "text": "Each state remembers *only what matters*. Here: 1 bit (even / odd)."
    }
   ]
  }
 ],
 "quiz": [
  {
   "q": "Which state is reached after reading 000?",
   "options": [
    "q0",
    "q1"
   ],
   "answer": 1,
   "why": "Three 0s is odd, so q1."
  },
  {
   "q": "Is the empty string accepted?",
   "options": [
    "Yes",
    "No"
   ],
   "answer": 0,
   "why": "Zero 0s is even and we start in the accepting state q0."
  }
 ]
}