# Which LLM writes the lessons: openai | gemini | replay (offline fixtures, no key needed)
BROFESSOR_PROVIDER=gemini
# Optional: override the default model for the provider (check the provider's docs for current names)
# BROFESSOR_MODEL=

OPENAI_API_KEY=
# Any OpenAI-compatible API works: Groq, OpenRouter, Together, a local Ollama (http://localhost:11434/v1)...
# OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=

# Frontend origin(s) allowed to call the API
BROFESSOR_CORS=http://localhost:3000
# Max lesson generations per IP per hour
BROFESSOR_RATE_LIMIT=20
# Prices in USD per 1M tokens for the eval cost column
# BROFESSOR_PRICE_IN=0
# BROFESSOR_PRICE_OUT=0

# Narration voice (Phase 4): edge (free neural voices, word timings) | sarvam (needs key) | off (browser voice only)
BROFESSOR_TTS=edge
# BROFESSOR_VOICE_EN=en-IN-NeerjaNeural      # or en-IN-PrabhatNeural
# BROFESSOR_VOICE_HI=hi-IN-SwaraNeural       # or hi-IN-MadhurNeural
# BROFESSOR_VOICE_RATE=-5%
# SARVAM_API_KEY=
# SARVAM_MODEL=                              # check Sarvam's docs for current model and speaker names
# SARVAM_SPEAKER_HI=
# SARVAM_SPEAKER_EN=
